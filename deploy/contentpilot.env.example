# Non-secret settings for the systemd units (secrets stay in .env, which the app loads itself).
# install.sh copies this to deploy/contentpilot.env the first time; edit that copy, not this file.
CP_API_PORT=8601
# Streamlit (read directly by Streamlit). Base path empty = it owns the root of its serve port.
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_BASE_URL_PATH=
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# No Chroma on the VM: meaning search (stored embeddings) + keywords, FTS when no vectors.
CONTENTPILOT_SEARCH=hybrid
# The LinkedIn scan needs your logged-in browser, so it runs on the laptop, not here.
LINKEDIN_SCAN_ENABLED=false
PYTHONUNBUFFERED=1
