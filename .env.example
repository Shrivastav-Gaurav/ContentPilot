# OpenRouter — used for all extraction and synthesis calls
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Overrides OPENROUTER_MODEL for Interview Prep synthesis only (quality over cost)
SYNTHESIS_MODEL=anthropic/claude-sonnet-5

# Jina Reader — optional; unset works at lower rate limits
JINA_API_KEY=

# LinkedIn — used by the Saved Scanner's Playwright login
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# LinkedIn Saved Scanner scheduling
LINKEDIN_SCAN_WINDOW=30d
LINKEDIN_SCAN_ENABLED=false
LINKEDIN_SCAN_CRON=30 17 * * 0

# LangSmith — optional; tracing is skipped silently if unset
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contentpilot
